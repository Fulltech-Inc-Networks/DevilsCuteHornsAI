{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dch-device-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dch-device-sync",
      "database_id": "b40ce5b6-cdb4-4b6b-b2f3-e09c00f1bc5b",
      "migrations_dir": "migrations"
    }
  ]
}
